# ============================================================
# EV CHARGING MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIG
# ============================================================

# Server Configuration
PORT=5001
NODE_ENV=production

# MySQL Database (Connection URL or Individual Parameters)
# Option A: Connection URL (e.g., Aiven, Railway, Render, Clever Cloud)
# DATABASE_URL=mysql://user:password@host:port/database

# Option B: Individual Connection Parameters
DB_HOST=your-mysql-host.cloud.aiven.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ev_charging_system
DB_SSL=true

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_encryption_key_min_32_chars

# Allowed Frontend Origins (Comma-separated for multiple domains)
CLIENT_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Razorpay Payment Gateway (Test Mode / Live)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email Configuration for OTP Verification (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
