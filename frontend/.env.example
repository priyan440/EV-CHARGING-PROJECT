# ============================================================
# EV CHARGING MANAGEMENT SYSTEM - FRONTEND ENVIRONMENT CONFIG
# ============================================================

# Backend API Endpoint (Points to your deployed backend or local dev)
# For Local Dev: http://localhost:5001/api
# For Production: https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend-app.onrender.com/api

# Optional: Real-Time WebSockets URL (Defaults to VITE_API_URL host if omitted)
VITE_SOCKET_URL=https://your-backend-app.onrender.com

# Razorpay Key ID (Public key for checkout popup - Test or Live)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Map API Key (Optional for OpenStreetMap / CARTO tile services)
VITE_MAP_API_KEY=
